# Token do bot no Discord Developer Portal
DISCORD_TOKEN=coloque_o_token_aqui

# Client/Application ID do bot
CLIENT_ID=coloque_o_client_id_aqui

# Guild ID opcional para registrar slash commands instantaneamente em um servidor de testes
GUILD_ID=coloque_o_guild_id_aqui

# Caminho do banco SQLite persistente
DATABASE_PATH=./data/faccao.sqlite

# Registra comandos automaticamente ao iniciar: true/false
REGISTER_COMMANDS_ON_READY=false

# Fuso usado em relatórios e embeds
TIMEZONE=America/Sao_Paulo
